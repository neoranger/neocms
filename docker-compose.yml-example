services:
  web:
    build: .
    restart: always
    container_name: NeoCMS_web
    ports:
      - "5000:5000"
    env_file:
      - .env
    volumes:
      - ./content:/app/content
      - ./static/uploads:/app/static/uploads
      - ./comments_data:/app/comments_data
      - ./config.json:/app/config.json
      - ./stats.db:/app/stats.db
      # Volumen persistente y escribible para el secreto 2FA (la app lo crea si no existe)
      - totp_secret:/app/totp
    # El locking de stats lo maneja SQLite internamente; no se necesita lock manual.
    # CAMBIO SEGURIDAD: Hardening del contenedor.
    # El entrypoint arranca como root para ajustar permisos y luego degrada a
    # appuser (no-root). Por eso necesita SOLO estas 4 capacidades mínimas.
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETUID
      - SETGID
      - DAC_OVERRIDE
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 512m
    cpus: 1.0

  comments:
    build: ./comments_service
    restart: always
    container_name: NeoCMS_comments
    # La API de comentarios la consume el navegador del visitante, por eso se
    # expone al host. Configura COMMENTS_API_URL con esta misma dirección.
    ports:
      - "5001:5001"
    env_file:
      - .env
    environment:
      - PYTHONUNBUFFERED=1
      # Restringir CORS al dominio público del blog. OBLIGATORIO en producción.
      - ALLOWED_ORIGIN=${PUBLIC_ORIGIN}
      # Notificación por Telegram de comentarios nuevos (opcional)
      - TELEGRAM_TOKEN=${TELEGRAM_TOKEN}
      - TELEGRAM_CHAT_ID=${TELEGRAM_CHAT_ID}
    volumes:
      - ./comments_data:/app/data
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETUID
      - SETGID
      - DAC_OVERRIDE
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 256m
    cpus: 0.5

volumes:
  totp_secret:
