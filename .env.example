# Configuración de Producción (¡NO subir a Git!)
# Copia este archivo a ".env" y completa los valores.

# --- OBLIGATORIO ---
# Genera una clave secreta larga y aleatoria:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Contraseña del panel de administración.
# Puede ir en texto plano (se migrará automáticamente a hash en el primer login)
# o directamente un hash de werkzeug: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('tu_password'))"
ADMIN_PASSWORD=

# --- PRODUCCIÓN (recomendado) ---
FLASK_ENV=production
FLASK_DEBUG=0

# Usar cookies seguras (poner en 1 si sirves detrás de HTTPS)
COOKIE_SECURE=1

# Dominio público del blog (para restringir el CORS del servicio de comentarios)
# p.ej. PUBLIC_ORIGIN=https://blog.tudominio.com
PUBLIC_ORIGIN=

# URL del servicio de comentarios ACCESIBLE DESDE EL NAVEGADOR del visitante.
# Debe ser la dirección pública/host donde el contenedor "comments" expone su puerto 5001.
# (NO puede ser un hostname interno de docker, el navegador no lo resolvería)
COMMENTS_API_URL=http://localhost:5001

# Notificaciones por Telegram de comentarios nuevos (opcional).
# Creá un bot con @BotFather y obtené tu chat_id con @userinfobot.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

